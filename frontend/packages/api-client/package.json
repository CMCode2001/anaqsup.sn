{
  "name": "@anaqsup/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Types et client générés depuis contracts/openapi/public-api.v1.yaml — ne pas éditer schema.d.ts à la main.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../../contracts/openapi/public-api.v1.yaml -o src/schema.d.ts && openapi-typescript ../../../contracts/openapi/admin-api.v1.yaml -o src/admin-schema.d.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
