# URL du backend vue DEPUIS le serveur Next.js (réseau Docker interne en staging/prod).
API_INTERNAL_URL=http://localhost:8080
# URL publique du site (canoniques, Open Graph, sitemap). ⚠️ NEXT_PUBLIC_* : valeurs FIGÉES au build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret partagé avec le backend pour POST /api/revalidate (≥ 32 caractères aléatoires).
REVALIDATE_SECRET=change-me-dev-only-0000000000000000
