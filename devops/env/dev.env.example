# Développement local — copier en devops/env/dev.env (ignoré par git).
ANAQSUP_VERSION=dev
REGISTRY=local

PUBLIC_HOST=localhost
WWW_HOST=www.localhost
API_HOST=api.localhost
ADMIN_HOST=localhost:5174
ROBOTS_TAG=noindex, nofollow

POSTGRES_SUPERUSER_PASSWORD=dev-postgres
ANAQSUP_DB_PASSWORD=anaqsup
REVALIDATE_SECRET=change-me-dev-only-0000000000000000
GRAFANA_ADMIN_PASSWORD=admin

# Back-office : adresse d'accès NON PUBLIÉE (décision ANAQ-Sup) → http://localhost:5174/${ADMIN_PATH}/
# Toute autre adresse répond 404. Une valeur différente par environnement : générer la vôtre dans dev.env
# avec  echo "espace-$(openssl rand -hex 8)"
ADMIN_PATH=espace-gestion-local
# Premier administrateur, créé si la base n'a aucun compte. Valeurs FACTICES de développement : mettre votre
# adresse dans dev.env (ignoré par git) ; mot de passe provisoire, à changer à la première connexion.
ADMIN_BOOTSTRAP_EMAIL=admin@anaqsup.local
ADMIN_BOOTSTRAP_PASSWORD=dev-a-changer

# Traduction automatique vers l'anglais (DeepL, décision ANAQ-Sup du 14/10/2026). Clé du compte DeepL API
# de l'ANAQ-Sup (offre gratuite : clé terminée par « :fx », 500 000 caractères par mois). Vide : pas de traduction.
DEEPL_API_KEY=
