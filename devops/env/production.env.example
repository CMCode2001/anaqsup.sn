# Production — déposé sur le serveur en /opt/anaqsup/shared/production.env (chmod 600, propriétaire deploy).
# Secrets : générer chacun avec `openssl rand -base64 48`. Ne JAMAIS les committer.
ANAQSUP_VERSION=
REGISTRY=ghcr.io/cmcode2001

PUBLIC_HOST=anaqsup.sn
WWW_HOST=www.anaqsup.sn
API_HOST=api.anaqsup.sn
ADMIN_HOST=admin.anaqsup.sn
ROBOTS_TAG=all

POSTGRES_SUPERUSER_PASSWORD=
ANAQSUP_DB_PASSWORD=
REVALIDATE_SECRET=
GRAFANA_ADMIN_PASSWORD=

BACKUP_RCLONE_REMOTE=
TLS_CONTACT_EMAIL=secretariat@anaqsup.sn

# Back-office : adresse d'accès NON PUBLIÉE, propre à cet environnement → https://${ADMIN_HOST}/${ADMIN_PATH}/
# À générer une fois : echo "espace-$(openssl rand -hex 8)" ; à communiquer uniquement aux personnes autorisées.
ADMIN_PATH=
# Premier administrateur (installation initiale seulement : ignoré dès qu'un compte existe).
# Mot de passe provisoire (8 caractères minimum), à changer à la première connexion ; vider ensuite ces valeurs.
# Adresse de l'administrateur de l'ANAQ-Sup : saisie dans le fichier réel du serveur, jamais dans git.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Traduction automatique vers l'anglais (DeepL, décision ANAQ-Sup du 14/10/2026). Clé du compte DeepL API
# de l'ANAQ-Sup (offre gratuite : clé terminée par « :fx », 500 000 caractères par mois). Vide : pas de traduction.
DEEPL_API_KEY=
