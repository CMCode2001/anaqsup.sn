# API publique (Spring Boot) — produit destiné aux partenaires.
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_HOST};

    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    # Autocomplétion : débit plus strict.
    location = /api/v1/public/search {
        limit_req zone=search burst=10 nodelay;
        proxy_pass http://backend;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Vérification de documents : anti-énumération des codes.
    location ^~ /api/v1/public/documents/verify/ {
        limit_req zone=verify burst=5 nodelay;
        proxy_pass http://backend;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Lectures publiques : cache Nginx (respecte Cache-Control/ETag du backend) et
    # service du contenu en cache si le backend est indisponible.
    location ^~ /api/v1/public/ {
        limit_except GET HEAD { deny all; }
        limit_req zone=api burst=40 nodelay;

        proxy_cache api_cache;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;

        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_pass http://backend;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Documentation : contrat OpenAPI (source de vérité) + Swagger UI.
    location ~ ^/(docs|swagger-ui|v3/api-docs|openapi)(/|$) {
        proxy_pass http://backend;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        return 404;
    }
}
